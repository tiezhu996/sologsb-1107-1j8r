{
  "name": "gbpapermill · 手工造纸帘纹与工序档案",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:import": "esbuild scripts/import-smoke.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/import-smoke.mjs --log-level=warning && node node_modules/.cache/import-smoke.mjs",
    "test:upgrade": "esbuild scripts/upgrade-smoke.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/upgrade-smoke.mjs --log-level=warning && node node_modules/.cache/upgrade-smoke.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
